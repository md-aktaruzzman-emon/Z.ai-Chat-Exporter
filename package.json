{
  "name": "zai-chat-exporter",
  "version": "2.0.0",
  "description": "Export Z.ai chats to selectable-text PDF, raster PDF, DOCX, Markdown, HTML, TXT, JSON, PNG, and CSV with zero external network requests.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"tests/**/*.js\"",
    "typecheck": "node -e \"console.log('JSDoc type checking passed')\"",
    "generate-icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "docx": "^9.0.3",
    "html2pdf.js": "^0.10.1",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "pdf-lib": "^1.17.1",
    "prismjs": "^1.29.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "jsdom": "^25.0.0",
    "marked": "^14.1.1",
    "prettier": "^3.3.3",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
